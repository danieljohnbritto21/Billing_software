# FoodBill Pro Backend Configuration Example
# Copy to .env and configure secrets accordingly

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL connection string via local loopback port 5433
# PGPASSWORD is read from /home/roosso/.foodbill_db_secret
DATABASE_URL="postgresql://foodbill_app:REPLACE_WITH_ACTUAL_PASSWORD@127.0.0.1:5433/foodbill?schema=public"

# JWT Secret for access token issuance
JWT_SECRET="replace_with_a_secure_random_64_character_hex_secret"
JWT_EXPIRES_IN="7d"

# Local Image Storage
IMAGE_STORAGE_PATH="/mnt/d/foodbill_storage/images"
